# Environment Configuration Example for NEXUS

# --- Cloud AI (Gemini) ---
# Optional: Get a free key at https://aistudio.google.com
# If omitted, NEXUS runs in local Offline/Degraded Mode with full ML & rule reasoning.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Database ---
# Default: Local SQLite (Zero configuration needed)
DATABASE_URL=sqlite+aiosqlite:///./nexus.db
# Alternative PostgreSQL URL (when running docker compose):
# DATABASE_URL=postgresql+asyncpg://nexus:nexus_secret@localhost:5432/nexus_db

# --- Networking ---
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000

# --- IoT & MQTT ---
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_TOPIC_SENSORS=nexus/sensors/telemetry

# --- Security ---
SECRET_KEY=nexus-development-secret-key-change-in-production
ENVIRONMENT=development

# --- Hardware Configuration (Laptop Built-in Defaults) ---
# Camera source: 0 is standard built-in laptop webcam (or leave blank for auto-detection)
VISION_CAMERA_SOURCE=0
# Audio input device index: leave blank to auto-use OS default built-in microphone array
AUDIO_DEVICE_INDEX=

# --- Firebase Realtime Database (Optional) ---
# Place your serviceAccountKey.json in the project root to enable cloud telemetry sync
FIREBASE_CREDENTIALS=serviceAccountKey.json
FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com

